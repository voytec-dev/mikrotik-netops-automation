# Adres NetBoxa (zmienna NETBOX_API czytana natywnie przez nb_inventory) oraz token API Read-Only (w NetBox v4.5+ prefiks nbt_)
export NETBOX_API=http://netbox.local:8000
export NETBOX_TOKEN=nbt_YOUR_NETBOX_READONLY_TOKEN

# Parametry używane przez playbook bootstrap_ansible.yml (adres WG serwera Ansible oraz klucz publiczny .pub)
export ANSIBLE_MGMT_IP=10.0.10.254/32
export ANSIBLE_PUBKEY_FILE=./ansible_mikrotik_ed25519.pub
