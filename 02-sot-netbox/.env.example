# Połączenie z instancją NetBox (REST API)
NETBOX_URL=http://netbox.local:8000
NETBOX_TOKEN=nbt_YOUR_KEY_ID.YOUR_SECRET_TOKEN
NETBOX_VERIFY_SSL=true

# Globalna sieć zarządzania WireGuard (Global VRF)
MGMT_VPN_ROLE_NAME=Wireguard Management
FALLBACK_MGMT_SUPERNET=10.0.0.0/22

# Automatyczne metadane pod Oxidized i dynamiczne inventory Ansible
AUTO_SET_PLATFORM=true
AUTO_TAG_OXIDIZED=true
OXIDIZED_TAG_NAME=oxidized
OXIDIZED_TAG_REQUIRE_MGMT_IP=true

# Zachowanie importera (idempotencja i archiwizacja plików)
ARCHIVE_IMPORTED_FILES=true
ARCHIVE_DIR_NAME=zaimportowane
CLEANUP_REMOVED_IPS=true
CLEANUP_REMOVED_VIRTUAL_INTERFACES=true

# Opcjonalny adres Oxidized Web UI dla skryptu audytowego (audit_wg_reconciliation.py)
# OXIDIZED_URL=http://netops-mgmt.local:8888
